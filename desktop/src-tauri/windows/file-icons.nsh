  WriteRegStr SHCTX "Software\Classes\.xml\OpenWithProgids" "DocViewer.xml" ""
  WriteRegStr SHCTX "Software\Classes\.toml\OpenWithProgids" "DocViewer.toml" ""
  WriteRegStr SHCTX "Software\Classes\.yaml\OpenWithProgids" "DocViewer.yaml" ""
  WriteRegStr SHCTX "Software\Classes\.yml\OpenWithProgids" "DocViewer.yaml" ""
  ExecWait `"$INSTDIR\${MAINBINARYNAME}.exe" --repair-file-associations pdf hwp hwt hwpx doc dot docx docm dotx dotm xls xlt xlsx xlsm xltx xltm csv tsv ppt pps pot pptx pptm ppsx potx md markdown txt text log json jsonc xml toml yaml yml`
  System::Call 'shell32::SHChangeNotify(i 0x08000000, i 0, p 0, p 0)'
!macroend
