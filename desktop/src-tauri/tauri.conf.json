{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Doc Viewer",
  "version": "0.0.0",
  "identifier": "dev.jwgung.docviewer",
  "build": {
    "frontendDist": "../dist",
    "beforeDevCommand": "pnpm build:front",
    "beforeBuildCommand": "pnpm build:front"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi", "nsis"],
    "createUpdaterArtifacts": true,
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "fileAssociations": [
      { "ext": ["pdf"], "name": "DocViewer.pdf", "role": "Viewer" },
      { "ext": ["hwp", "hwt"], "name": "DocViewer.hwp", "role": "Viewer" },
      { "ext": ["hwpx"], "name": "DocViewer.hwpx", "role": "Viewer" },
      { "ext": ["doc", "dot"], "name": "DocViewer.doc", "role": "Viewer" },
      { "ext": ["docx", "docm", "dotx", "dotm"], "name": "DocViewer.docx", "role": "Viewer" },
      { "ext": ["xls", "xlt"], "name": "DocViewer.xls", "role": "Viewer" },
      { "ext": ["xlsx", "xlsm", "xltx", "xltm"], "name": "DocViewer.xlsx", "role": "Viewer" },
      { "ext": ["csv", "tsv"], "name": "DocViewer.csv", "role": "Viewer" },
      { "ext": ["ppt", "pps", "pot"], "name": "DocViewer.ppt", "role": "Viewer" },
      { "ext": ["pptx", "pptm", "ppsx", "potx"], "name": "DocViewer.pptx", "role": "Viewer" },
      { "ext": ["md", "markdown"], "name": "DocViewer.md", "role": "Viewer" },
      { "ext": ["txt", "text"], "name": "DocViewer.txt", "role": "Viewer" },
      { "ext": ["log"], "name": "DocViewer.log", "role": "Viewer" },
      { "ext": ["json", "jsonc"], "name": "DocViewer.json", "role": "Viewer" },
      { "ext": ["xml"], "name": "DocViewer.xml", "role": "Viewer" },
      { "ext": ["toml"], "name": "DocViewer.toml", "role": "Viewer" },
      { "ext": ["yaml", "yml"], "name": "DocViewer.yaml", "role": "Viewer" }
    ],
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper" },
      "nsis": { "installerIcon": "icons/icon.ico" }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDNCN0Q1MUZFNzg2RDM2MjkKUldRcE5tMTQvbEY5TzRBSk9LemZHRGRiOU1PYXpjbTJTbFF3SVJXdW82WGtkSDJIL1VoLy9MaWEK",
      "endpoints": ["https://github.com/jwgung/doc-viewer/releases/latest/download/latest.json"],
      "windows": { "installMode": "passive" }
    }
  }
}
