+  const width = 960;
+  const height = 720;
+  const slides: Slide[] = groups.map((texts) => {
+    const [first, ...rest] = texts;
+    const elements: ShapeElement[] = [box(48, 32, width - 96, 120, textBody(first, 40, true, 'middle'))];
