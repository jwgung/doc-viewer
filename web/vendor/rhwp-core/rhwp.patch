+/// [A1 성능] 표 하나의 행→셀 색인. `rows[r]` 는 `cell.row == r` 인 셀의 인덱스를
+/// 원래 `table.cells` 순서대로 담는다. 행마다 전체 셀을 다시 훑던 질의를 행 단위
+/// 조회로 바꾸는 데 쓴다. 셀 구성(행 번호·개수)만 담고 높이·내용은 담지 않는다.
+pub(crate) struct TableRowCells {
+    cells_ptr: usize,
+    cells_len: usize,
+    rows: Vec<Vec<u32>>,
+    /// `row_span > 1` 셀이 하나라도 있는가.
+    has_row_span: bool,
+}
+
+impl TableRowCells {
+    fn build(table: &crate::model::table::Table) -> Self {
+        let mut rows = vec![Vec::new(); table.row_count as usize];
+        let mut has_row_span = false;
+        for (index, cell) in table.cells.iter().enumerate() {
+            if let Some(row) = rows.get_mut(cell.row as usize) {
+                row.push(index as u32);
+            }
+            has_row_span |= cell.row_span > 1;
+        }
+        Self {
+            cells_ptr: table.cells.as_ptr() as usize,
+            cells_len: table.cells.len(),
+            rows,
+            has_row_span,
+        }
+    }
+
+    fn matches(&self, table: &crate::model::table::Table) -> bool {
+        self.cells_ptr == table.cells.as_ptr() as usize
+            && self.cells_len == table.cells.len()
+            && self.rows.len() == table.row_count as usize
+    }
+
+    pub(crate) fn has_row_span(&self) -> bool {
+        self.has_row_span
+    }
+}
+
+/// [A1 성능] `table.cells.iter().filter(|c| c.row as usize == row)` 와 같은 셀을 같은
+/// 순서로 돌려주는 반복자. 색인이 없는 행(행 수 밖)은 종전처럼 전체를 훑는다.
+pub(crate) enum RowCellsIter<'t> {
+    Indexed {
+        cells: &'t [crate::model::table::Cell],
+        index: std::sync::Arc<TableRowCells>,
+        row: usize,
+        pos: usize,
+    },
+    Scan {
+        iter: std::slice::Iter<'t, crate::model::table::Cell>,
+        row: usize,
+    },
+}
+
+impl<'t> Iterator for RowCellsIter<'t> {
+    type Item = &'t crate::model::table::Cell;
+
+    fn next(&mut self) -> Option<Self::Item> {
+        match self {
+            RowCellsIter::Indexed {
+                cells,
+                index,
+                row,
+                pos,
+            } => {
+                let slot = *index.rows[*row].get(*pos)?;
+                *pos += 1;
+                cells.get(slot as usize)
+            }
+            RowCellsIter::Scan { iter, row } => {
+                let row = *row;
+                iter.find(|cell| cell.row as usize == row)
+            }
+        }
+    }
+}
