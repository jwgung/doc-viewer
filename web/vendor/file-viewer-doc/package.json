{
  "name": "@file-viewer/doc",
  "version": "3.1.2-docviewer.1",
  "private": true,
  "type": "module",
  "description": "Browser-native legacy MS-DOC (.doc) parser and HTML renderer extracted from the public msdoc-viewer 0.2.0 line. doc-viewer fork: see PATCHES.md.",
  "author": {
    "name": "Yu Wang",
    "email": "admin@flyfish.dev"
  },
  "repository": {
    "type": "git",
